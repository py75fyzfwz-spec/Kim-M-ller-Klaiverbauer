// Cloudflare Worker: serves the static site and handles the contact form.
// Set the Resend API key as a secret named RESEND_API_KEY
// (Cloudflare dashboard → Worker → Settings → Variables and Secrets).
{
  "name": "kim-m-ller-klavierbauer",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
